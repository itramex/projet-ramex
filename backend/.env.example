# ============================================
# Backend .env template - Projet RAMEX
# Copiez ce fichier en `.env` et adaptez les valeurs
# ============================================

# --- Django Core ---
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (PostgreSQL + PostGIS) ---
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=vanille_db
DB_USER=vanille_user
DB_PASSWORD=vanille_pass_2025
DB_HOST=localhost
DB_PORT=5432

# --- Tests (optionnel, local Windows sans superuser) ---
# Si l'utilisateur DB n'est pas superuser, il ne peut pas créer l'extension
# PostGIS dans la base de test. Créez une base template PostGIS :
#   CREATE DATABASE template_postgis;
#   \c template_postgis
#   CREATE EXTENSION postgis;
#   UPDATE pg_database SET datistemplate = TRUE WHERE datname = 'template_postgis';
# Puis décommentez la ligne suivante :
# DB_TEST_TEMPLATE=template_postgis

# --- JWT Token Settings ---
# Access token: courte durée pour sécurité (15 minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token: longue durée pour UX mobile (30 jours)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
# Rotation des refresh tokens pour sécurité
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# --- GDAL / GEOS (Windows uniquement) ---
# Laissez vide si GDAL est dans le PATH système ou si vous utilisez Linux/Mac
# Exemple Windows: C:\Program Files\PostgreSQL\17\bin
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
OSGEO4W_PATH=

# --- Ollama (optionnel) ---
# False par défaut : l'assistant chatbot utilise l'analyse locale par patterns
# (aucun appel réseau, réponses instantanées). True pour activer le traitement
# IA via le serveur Ollama local (modèle llama3.2 attendu).
CHATBOT_USE_OLLAMA=False
OLLAMA_HOST=http://localhost:11434

# --- Email (optionnel) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO