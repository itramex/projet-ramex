# Backend .env template
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production

# Database
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=vanille_db
DB_USER=vanille_user
DB_PASSWORD=vanille_pass_2025
DB_HOST=localhost
DB_PORT=5432

# JWT Token Settings
# Access token: courte durée pour sécurité (15 minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Refresh token: longue durée pour UX mobile (30 jours)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
# Rotation des refresh tokens pour sécurité
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Ollama (optional)
OLLAMA_HOST=http://localhost:11434
